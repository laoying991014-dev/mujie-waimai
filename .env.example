# ============================================================
# 木姐外卖 - 环境变量配置示例
# 复制为 .env 文件并修改为实际值
# ============================================================

# ---------- 服务配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=production

# ---------- 数据库配置 ----------
DATABASE_URL=postgresql://mujie:mujie123@localhost:5432/mujie_waimai

# ---------- JWT 配置 ----------
JWT_SECRET=mujie-waimai-jwt-secret-key-change-me
JWT_EXPIRES_IN=7d

# ---------- CSRF 配置 ----------
ENABLE_CSRF=false

# ---------- 自建部署开关 ----------
# 自建部署必须设为 true，禁用妙搭平台数据库模块
FORCE_FRAMEWORK_DISABLE_DATAPASS=true
