# ============================================================
# 木姐外卖 - 环境变量配置示例
# 复制为 .env 文件并修改为实际值
# ============================================================

# ---------- 服务配置 ----------
# 服务监听地址
SERVER_HOST=0.0.0.0
# 服务端口
SERVER_PORT=3000
# 运行环境: development / production
NODE_ENV=production

# ---------- 数据库配置 ----------
# PostgreSQL 连接地址
# 格式: postgresql://<用户名>:<密码>@<主机>:<端口>/<数据库名>
DATABASE_URL=postgresql://mujie:mujie123@localhost:5432/mujie_waimai

# ---------- JWT 配置 ----------
# JWT 签名密钥（生产环境务必修改为随机强口令）
JWT_SECRET=mujie-waimai-jwt-secret-key-change-me
# JWT 过期时间
JWT_EXPIRES_IN=7d

# ---------- CSRF 配置 ----------
# 是否启用 CSRF 保护（生产环境建议开启）
ENABLE_CSRF=false
